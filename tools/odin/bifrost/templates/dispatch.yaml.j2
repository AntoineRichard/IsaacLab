workflow:
  name: odin-disp-{{ dispatch_id }}
  timeout:
    exec_timeout: {{ exec_timeout }}
    queue_timeout: {{ cfg.defaults.queue_timeout }}s
  resources:
    default:
      cpu: {{ cfg.defaults.resources.cpu }}
      gpu: {{ cfg.defaults.resources.gpu }}
      memory: {{ cfg.defaults.resources.memory }}
      storage: {{ cfg.defaults.resources.storage }}
      platform: {{ cfg.defaults.resources.platform }}
  tasks:
{% for row in rows %}
  - name: {{ row.osmo_task_name }}
    image: {{ cfg.image.reference }}
    environment:
      ACCEPT_EULA: "Y"
      NO_NUCLEUS: "Y"
      OMNI_KIT_ALLOW_ROOT: "1"
      ODIN_DISPATCH_ID: "{{ dispatch_id }}"
      ODIN_RUN_ID: "{{ row.run_id }}"
      # Defense in depth: image already sets these, but re-apply here in case
      # the OSMO node runs a stripped image where the Dockerfile ENVs are lost.
      # Avoids openblas pthread_atfork crash in kit's fork path.
      OPENBLAS_NUM_THREADS: "1"
      OMP_NUM_THREADS: "1"
      MKL_NUM_THREADS: "1"
    command: ["bash"]
    args: ["/tmp/entry.sh"]
    files:
    - path: /tmp/entry.sh
      contents: |
        set -euxo pipefail
{% if cfg.code_delivery.mode == "files_upload" %}
        tar -xzf /workspace/odin-source.tar.gz -C /workspace/isaaclab
{% endif %}
        cd /workspace/isaaclab
        set +e
        ./isaaclab.sh -p tools/odin/{{ row.framework_runner }}/run.py \
          --task {{ row.task_id }} \
          --backend {{ row.backend }} \
          --seed {{ row.seed }} \
          --num_envs {{ row.num_envs }} \
          --max_iterations {{ row.max_iterations }} \
          --run_id "$ODIN_RUN_ID" \
          --runs_root '{{ '{{output}}' }}'
        rc=$?
        echo "=== entry.sh: exit_code=$rc ==="
        echo "=== bundle contents ==="
        find {{ '{{output}}' }} -type f | head -30
        echo "=== training.stderr.log ==="
        find {{ '{{output}}' }} -name 'training.stderr.log' -exec cat {} \;
        echo "=== training.stdout.log (last 50 lines) ==="
        find {{ '{{output}}' }} -name 'training.stdout.log' -exec tail -50 {} \;
        echo "=== startup.stderr.log ==="
        find {{ '{{output}}' }} -name 'startup.stderr.log' -exec cat {} \;
        exit $rc
{% if cfg.code_delivery.mode == "files_upload" %}
    - localpath: odin-source.tar.gz
      path: /workspace/odin-source.tar.gz
{% endif %}
{% if cfg.bundle_dataset_prefix %}
    outputs:
    - dataset:
        name: {{ cfg.bundle_dataset_prefix }}-{{ dispatch_id }}-{{ row.run_id }}
{% endif %}
{% if cfg.retry.reschedule_codes or cfg.retry.restart_codes %}
    exitActions:
{% if cfg.retry.reschedule_codes %}
      RESCHEDULE: {{ cfg.retry.reschedule_codes }}
{% endif %}
{% if cfg.retry.restart_codes %}
      RESTART: {{ cfg.retry.restart_codes }}
{% endif %}
{% endif %}
{% endfor %}
